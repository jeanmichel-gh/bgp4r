# A copy of ../bgp4r-lab/Dockerfile.bird, whose comments say why it exists.
# routescope builds a lab image from the lab's own folder, so each lab
# carries its Dockerfiles. rr_lab_topology_test.rb holds this copy to
# the same instructions as that one.

FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends bird2 iproute2 procps \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /run/bird
# Foreground, logging to stderr (docker logs), control socket where birdc looks.
ENTRYPOINT ["bird", "-f", "-c", "/etc/bird/bird.conf", "-s", "/run/bird/bird.ctl"]

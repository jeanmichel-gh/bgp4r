# A copy of ../bgp4r-lab/Dockerfile.node, whose comments say why it exists.
# routescope builds a lab image from the lab's own folder, so each lab
# carries its Dockerfiles. fwd_lab_topology_test.rb holds this copy to
# the same instructions as that one.

ARG RUBY_VERSION=3.4
FROM ruby:${RUBY_VERSION}-slim
RUN apt-get update && apt-get install -y --no-install-recommends iproute2 iputils-ping traceroute \
    && rm -rf /var/lib/apt/lists/*
ARG BGP4R_REF=master
ADD https://api.github.com/repos/jeanmichel-gh/bgp4r/commits/${BGP4R_REF} /etc/bgp4r-commit.json
RUN ruby -rjson -e 'puts JSON.parse(File.read("/etc/bgp4r-commit.json")).fetch("sha")' \
      > /etc/bgp4r-revision
ADD https://github.com/jeanmichel-gh/bgp4r.git#${BGP4R_REF} /app
WORKDIR /app
# A shell in the node types the commands by name, and the client finds
# the daemon's socket with no -s: `bgp4r-cli -c 'show bgp'`, or `cli`
# for short. docs/bgp4r-cli.md is the guide to that shell.
RUN for c in bgp4r bgp4rd bgp4r-cli bgp4r-sim; do ln -s /app/exe/$c /usr/local/bin/$c; done \
 && ln -s /app/exe/bgp4r-cli /usr/local/bin/cli
ENV BGP4R_SOCKET=/run/bgp4r/bgp4rd.sock
EXPOSE 179
ENTRYPOINT ["ruby", "-I/app"]

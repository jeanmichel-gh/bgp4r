# The bgp4r node image for this lab, built from this folder alone:
#
#   docker build -f Dockerfile.node -t bgp4r-lab:latest .
#
# **Why a second recipe for an image the root Dockerfile already
# builds.** The root one's `lab-node` stage builds from a bgp4r
# checkout, which is what CI wants: it tests the branch. A copy of this
# folder made by `bgp4r lab new` has no checkout behind it, so it cannot
# build that stage, and routescope builds a lab's images from the lab
# folder (the `routescope.build` label on each node). This one fetches
# bgp4r from GitHub instead, so it builds anywhere, and what it runs is
# master rather than a local edit. To run a local edit, build the root
# Dockerfile's `lab-node` stage under the same tag.
#
# **It rebuilds only when master moves, and says which commit it has.**
# The first `ADD` fetches GitHub's answer for the commit `BGP4R_REF`
# names. BuildKit fetches a remote URL on every build, so a new commit
# changes that layer and every layer after it, the git `ADD` included.
# That `ADD` alone was trusted to notice a new commit, and on
# 2026-11-06 a lab ran an injector from before #308 after master had
# moved. Whether the git layer was cached or the containers were never
# recreated was not settled; this makes the first impossible and the
# second checkable, since /etc/bgp4r-revision holds the commit:
#
#   docker run --rm --entrypoint cat bgp4r-lab:latest /etc/bgp4r-revision
#   docker exec clab-rr-lab-inj-c cat /etc/bgp4r-revision
#
# The two should agree, and match `git ls-remote` for master. A running
# container keeps the image it started from, so after a rebuild the
# lab has to be stopped and started for the second to move. The API
# allows 60 unauthenticated requests an hour per address, one per
# build. It needs BuildKit, which `docker build` uses whenever the
# buildx plugin is installed; the legacy builder cannot add a git URL.
#
# The rest is `lab-node`: Ruby, iproute2 for the `exec: ip addr add`
# lines, ping and traceroute so fwd-lab can send traffic through a
# node, and root so `bgp4rd` can create `/run/bgp4r`. No gems: the
# library's one runtime gem, `logger`, ships with Ruby 3.4, and the
# root Dockerfile's Gemfile install is test and development gems.

ARG RUBY_VERSION=3.4
FROM ruby:${RUBY_VERSION}-slim
RUN apt-get update && apt-get install -y --no-install-recommends iproute2 iputils-ping traceroute \
    && rm -rf /var/lib/apt/lists/*
ARG BGP4R_REF=master
ADD https://api.github.com/repos/jeanmichel-gh/bgp4r/commits/${BGP4R_REF} /etc/bgp4r-commit.json
RUN ruby -rjson -e 'puts JSON.parse(File.read("/etc/bgp4r-commit.json")).fetch("sha")' \
      > /etc/bgp4r-revision
ADD https://github.com/jeanmichel-gh/bgp4r.git#${BGP4R_REF} /app
WORKDIR /app
# A shell in the node types the commands by name, and the client finds
# the daemon's socket with no -s: `bgp4r-cli -c 'show bgp'`, or `cli`
# for short. docs/bgp4r-cli.md is the guide to that shell.
RUN for c in bgp4r bgp4rd bgp4r-cli bgp4r-sim; do ln -s /app/exe/$c /usr/local/bin/$c; done \
 && ln -s /app/exe/bgp4r-cli /usr/local/bin/cli
ENV BGP4R_SOCKET=/run/bgp4r/bgp4rd.sock
EXPOSE 179
ENTRYPOINT ["ruby", "-I/app"]

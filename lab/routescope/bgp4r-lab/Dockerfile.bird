# BIRD 2 for the bgp4r-lab topology: the third implementation on it.
#
#   docker build -f lab/routescope/bgp4r-lab/Dockerfile.bird \
#                -t bgp4r-bird:latest lab/routescope/bgp4r-lab
#
# **This is ospfv2's docker/bird/Dockerfile**, read at ospfv2 2dfc03a,
# with the entrypoint's socket path unchanged so `birdc` and routescope's
# BIRD driver both find it. It is copied rather than referenced because a
# bgp4r lab that cannot be deployed without an ospfv2 checkout is a lab
# with a dependency nobody reading this repository would expect. Any
# image carrying bird2 and iproute2 does instead; ospfv2-bird:latest is
# the same thing under another name.
#
# `iproute2` is what the topology's `exec:` lines need and `procps` is
# for a person in its shell.
#
# **Not built here.** No Docker daemon was reachable where this was
# written, which the Dockerfile at the repository root records of its own
# capture stage for the same reason. Build it before trusting it.
FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends bird2 iproute2 procps \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /run/bird
# Foreground, logging to stderr (docker logs), control socket where birdc looks.
ENTRYPOINT ["bird", "-f", "-c", "/etc/bird/bird.conf", "-s", "/run/bird/bird.ctl"]

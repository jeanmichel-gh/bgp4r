# The bgp4r umbrella command. See docs/daemon.md.
#
# The gemspec's require_paths is ["."], the repository root, so the
# library is required as 'bgp/...' both from a checkout and installed.
# Installed, exe/ is on PATH and the gem's root is one directory up from
# this file; from a checkout the same arithmetic reaches the same place,
# so one line covers both.
root = File.expand_path('..', __dir__)
$LOAD_PATH.unshift(root) unless $LOAD_PATH.include?(root)

require 'bgp/capture/cli'

exit BGP::Capture::CLI.new.start(ARGV)

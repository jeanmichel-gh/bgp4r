# bgp4rd, the BGP daemon. Talk to it with bgp4r-cli. See docs/daemon.md.
#
# The load path line is exe/bgp4r's, for the reason written there: the
# gemspec's require_paths is ["."], so one piece of arithmetic reaches
# the library both from a checkout and from an installed gem.
root = File.expand_path('..', __dir__)
$LOAD_PATH.unshift(root) unless $LOAD_PATH.include?(root)

$stdout.sync = true
$stderr.sync = true

require 'bgp/daemon/server'

exit BGP::Daemon::Server.new.start(ARGV)
